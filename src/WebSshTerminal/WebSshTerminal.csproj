<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>web-ssh-terminal-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo original de TuteApps: una sola còpia, a assets/branding. -->
    <Content Include="..\..\assets\branding\TuteApps_Logo.png" Link="wwwroot\branding\TuteApps_Logo.png" CopyToPublishDirectory="PreserveNewest" />
    <!-- Branding per defecte de la instància (substituïble sense recompilar: <dades>/branding/). -->
    <Content Include="..\..\assets\branding\salesians-*" Exclude="..\..\assets\branding\salesians-favicon.ico" Link="wwwroot\branding\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <!-- /favicon.ico a l'arrel: els navegadors el demanen sense autenticació encara que no hi hagi <link>. -->
    <Content Include="..\..\assets\branding\salesians-favicon.ico" Link="wwwroot\favicon.ico" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebSshTerminal.Tests" />
  </ItemGroup>

</Project>
