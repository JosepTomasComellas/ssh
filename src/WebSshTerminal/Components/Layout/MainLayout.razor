@inherits LayoutComponentBase
@inject WebSshOptions Options
@inject WebSshTerminal.Configuration.BrandingService Brand

<MudThemeProvider />

<header class="appbar">
    <a class="brand" href="/" aria-label="@Brand.AppName — inici">
        <img class="brand-logo" src="@Brand.LogoUrl" alt="@Brand.OrgName" />
        <span class="brand-name">@Brand.AppName</span>
    </a>

    <AuthorizeView>
        <Authorized>
            <nav class="appnav" aria-label="Navegació principal">
                <a class="nav-link" href="/terminal"><MudIcon Icon="@Icons.Material.Filled.Terminal" />Terminal</a>
                <AuthorizeView Policy="@WebSshTerminal.Auth.AuthSetup.AdminPolicy" Context="adminCtx">
                    <a class="nav-link" href="/admin/users"><MudIcon Icon="@Icons.Material.Filled.People" />Usuaris</a>
                    <a class="nav-link" href="/admin/identities"><MudIcon Icon="@Icons.Material.Filled.VpnKey" />Identitats</a>
                </AuthorizeView>
                <a class="nav-link" href="/account/mfa"><MudIcon Icon="@Icons.Material.Filled.Security" />MFA</a>
            </nav>
            <div class="appuser">
                <span class="chip">@(context.User.IsInRole("admin") ? "Administrador" : "Usuari")</span>
                <span class="who">@context.User.Identity?.Name</span>
                <form method="post" action="/account/logout" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="btn">Surt</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</header>

<main class="page @PageClass">
    @Body
</main>

<footer class="source-footer">
    @Brand.OrgName · @Brand.OrgDept ·
    <a href="@Options.SourceUrl" rel="noopener">Codi font</a> ·
    <a href="@(Options.SourceUrl + "/blob/main/LICENSE")" rel="noopener">Llicència AGPL-3.0</a> ·
    <span title="Revisió executada">@Revision</span>
</footer>

<TuteAppsCredit />

<div id="blazor-error-ui" data-nosnippet>
    S'ha produït un error inesperat.
    <a href="." class="reload">Recarrega</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private string Revision => WebSshTerminal.Infrastructure.BuildInfo.Revision[..12];
    // El terminal ocupa tot l'ample disponible; la resta de pàgines, una columna centrada.
    private string PageClass => new Uri(Nav.Uri).AbsolutePath.StartsWith("/terminal", StringComparison.Ordinal) ? "page--wide" : "";
}
