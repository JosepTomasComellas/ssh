@page "/terminal"

<PageTitle>Terminal</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="lib/xterm/xterm.css" />
</HeadContent>

<div class="terminal-page">
    <section class="terminal-main" aria-label="Terminal">
        <div class="terminal-toolbar" role="toolbar" aria-label="Accions del terminal">
            <button type="button" id="btn-new" class="btn btn-primary">Nova sessió</button>
            <label for="session-select" class="visually-hidden">Sessió</label>
            <select id="session-select"></select>
            <button type="button" id="btn-connect" class="btn">Connecta</button>
            <button type="button" id="btn-disconnect" disabled>Desconnecta</button>
            <button type="button" id="btn-close" title="Tanca la sessió tmux al servidor remot">Tanca la sessió</button>
            <button type="button" id="btn-copy" title="Copia la selecció (també: clic dret amb selecció, o Ctrl+Maj+C)">Copia</button>
            <button type="button" id="btn-paste" title="Enganxa (també: clic dret sense selecció, o Ctrl+Maj+V). Maj+clic dret: menú del navegador">Enganxa</button>
            <button type="button" id="btn-files" aria-expanded="false" aria-controls="files-panel" title="Mostra o amaga el panell de fitxers">Fitxers</button>
            <button type="button" id="btn-tabfocus" aria-pressed="false" title="Quan està activat, Tab i Maj+Tab surten del terminal en lloc d'enviar-se a la shell (drecera: Ctrl+Maj+M)">Tab mou el focus</button>
            <span id="status" role="status" aria-live="polite" class="terminal-status">Sense connexió</span>
            <code id="session-id" class="terminal-session-id" title="Identificador de la sessió"></code>
        </div>
        <div id="terminal" role="application" aria-label="Terminal SSH. Tab s'envia a la shell; activa «Tab mou el focus» (Ctrl+Maj+M) per sortir amb el teclat."></div>
        <div id="terminal-error" role="alert" class="form-error" hidden></div>
    </section>

    <aside class="terminal-files" id="files-panel" aria-label="Fitxers" hidden>
        <h2 class="mud-typography mud-typography-h6">Fitxers</h2>
        <p class="hint">Dins el teu directori personal del servidor remot.</p>
        <label for="files-path">Carpeta</label>
        <div class="files-path-row">
            <input id="files-path" value="" placeholder="(directori personal)" autocomplete="off" />
            <button type="button" id="btn-files-list">Llista</button>
        </div>
        <ul id="files-list" class="files-list"></ul>
        <label for="upload-file">Pujar un fitxer a aquesta carpeta</label>
        <input id="upload-file" type="file" />
        <div id="overwrite-box" hidden>
            <p role="alert">El fitxer ja existeix. El vols sobreescriure?</p>
            <button type="button" id="btn-overwrite">Sobreescriu</button>
            <button type="button" id="btn-overwrite-cancel">Cancel·la</button>
        </div>
        <div id="files-status" role="status" aria-live="polite"></div>
    </aside>
</div>

