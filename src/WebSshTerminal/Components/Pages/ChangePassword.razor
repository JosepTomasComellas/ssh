@page "/password"

<PageTitle>Canvi de contrasenya</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
    <MudPaper Class="pa-6">
        <h1 class="mud-typography mud-typography-h5">Canvi de contrasenya</h1>
        @if (Error is not null)
        {
            <div role="alert" class="form-error">
                @(Error == "mismatch" ? "Els camps no coincideixen." : "La contrasenya actual no és correcta o la nova no compleix la política (mínim 12 caràcters).")
            </div>
        }
        <form method="post" action="/account/password" class="plain-form">
            <AntiforgeryToken />
            <label for="current">Contrasenya actual</label>
            <input id="current" name="current" type="password" autocomplete="current-password" required />
            <label for="next">Contrasenya nova</label>
            <input id="next" name="next" type="password" autocomplete="new-password" minlength="12" required />
            <label for="confirm">Repeteix la nova</label>
            <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="12" required />
            <button type="submit">Canvia</button>
        </form>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
