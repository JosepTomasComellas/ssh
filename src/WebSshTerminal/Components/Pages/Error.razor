@page "/Error"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="card" style="max-width:640px;margin:2rem auto">
    <div class="page-title"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" /><h1>S'ha produït un error</h1></div>
    <p>No hem pogut completar la petició. Torna-ho a provar; si continua passant, avisa l'administrador.</p>
    @if (ShowRequestId)
    {
        <p class="hint">Identificador per a l'administrador: <code>@RequestId</code></p>
    }
    <a class="btn" href="/">Torna a l'inici</a>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
