@page "/login/2fa"
@layout Layout.LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Verificació en dos passos</PageTitle>

<h2>Verificació en dos passos</h2>
@if (Error is not null)
{
    <div role="alert" class="form-error">Codi incorrecte.</div>
}
<form method="post" action="/account/2fa" class="plain-form">
    <AntiforgeryToken />
    <label for="code">Codi de l'aplicació d'autenticació (6 dígits)</label>
    <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" autofocus />
    <button type="submit" class="btn btn-primary btn-block">Verifica</button>
</form>
<details class="plain-form">
    <summary>He perdut l'aplicació: usar un codi de recuperació</summary>
    <form method="post" action="/account/2fa" class="plain-form">
        <AntiforgeryToken />
        <label for="recovery">Codi de recuperació</label>
        <input id="recovery" name="recovery" autocomplete="off" />
        <button type="submit" class="btn btn-block">Usa el codi</button>
    </form>
</details>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
