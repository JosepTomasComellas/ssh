      "id": 1,
      "title": "Estat del servei (up)",
      "description": "1 = el scrape funciona",
      "type": "stat",
      "datasource": {
        "uid": "webssh-prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"web-ssh-terminal\"}",
          "legendFormat": "up",
          "datasource": {
            "uid": "webssh-prometheus",
            "type": "prometheus"
          }
        }
      ]
    },
