    {
      "id": 4,
      "title": "Connexions SSH per resultat (per minut)",
      "description": "Errors: hostkey, auth, unreachable, other",
      "type": "timeseries",
      "datasource": {
        "uid": "webssh-prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(webssh_ssh_connections_total[5m])) / 5",
          "legendFormat": "{{result}}",
          "datasource": {
            "uid": "webssh-prometheus",
            "type": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Errors i rebuigs per categoria (per minut)",
