# Configuració MÍNIMA del servidor (Traefik). Copia a .env a l'arrel del clon i ajusta. Mode 0600.
# scripts/server-deploy.sh genera config.json, known_hosts i la resta a partir d'aquí.

# --- Obligatoris ---------------------------------------------------------------------------
DOMAIN=ssh.sdslab.cat
# Clau PÚBLICA age per xifrar les còpies (age-keygen -o clau-privada.txt; guarda la privada FORA del servidor).
BACKUP_RECIPIENT=

# --- Opcionals (els valors per defecte són els que es mostren) -----------------------------
# WEBSSH_ROOT=/docker/ssh                 # on s'instal·la (dades, secrets, còpies, versions)
# GHCR_IMAGE=ghcr.io/joseptomascomellas/ssh
# PROXY_NETWORK=traefik                   # xarxa Docker compartida amb Traefik
# TRAEFIK_CONTAINER=traefik               # nom del contenidor de Traefik (per detectar-ne la IP)
# TRAEFIK_RESOLVER=letsencrypt
# TZ=Europe/Madrid                        # zona horària dels logs
# REQUIRE_MFA=true                        # tothom ha d'activar TOTP
# SSH_PORT=22
# SSH_HOST=                               # buit = IP del servidor a la xarxa de l'app (detectada)
# BACKEND_SUBNET=                         # buit = una 172.30.X.0/24 lliure (es manté entre execucions)
